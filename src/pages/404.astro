---
import Layout from '@/layouts/Layout.astro';
import LocalizedLink from '@/components/navigation/LocalizedLink';
import { Button } from '@/components/ui/button';
import { ChefHat, Home } from 'lucide-react';
import { getTranslations } from '@/lib/i18n';

// Set response status explicitly
Astro.response.status = 404;

// Detect requested locale from URL pathname (e.g. /de/aboutsss -> 'de')
const pathname = Astro.url?.pathname || '';
const firstSegment = pathname.split('/').filter(Boolean)[0];
const currentLang = (firstSegment === 'en' || firstSegment === 'de' || firstSegment === 'es')
  ? firstSegment
  : 'es';

const t = getTranslations(currentLang);
---

<Layout
  title={t("notFound.title", "404: Página no encontrada | tortilladepatatas.org")}
  description={t("notFound.description", "La página que buscas sobre la tortilla de patatas no se encuentra disponible.")}
  lang={currentLang}
  noindex={true}
>
  <div class="container mx-auto px-4 py-24 text-center max-w-lg">
    <div class="p-4 rounded-full bg-[#F5E6BE] text-[#8D6E63] border border-amber-300 w-20 h-20 mx-auto mb-6 flex items-center justify-center shadow-inner">
      <ChefHat class="w-10 h-10" />
    </div>
    <h1 class="text-4xl font-black text-foreground mb-3 font-serif-heading">
      {t("notFound.heading", "404")}
    </h1>
    <h2 class="text-xl font-bold text-foreground mb-2 font-serif-heading">
      {t("notFound.subheading", "Página no encontrada")}
    </h2>
    <p class="text-base sm:text-lg text-muted-foreground mb-8">
      {t("notFound.description", "¡Vaya! Esta tortilla se nos ha dado la vuelta mal. La página que buscas no existe o ha sido movida.")}
    </p>
    <LocalizedLink to="/">
      <Button class="bg-[#8D6E63] hover:bg-[#73564B] text-white font-bold gap-2 shadow-sm">
        <Home class="w-4 h-4" />
        <span>{t("notFound.homeButton", "Volver al inicio")}</span>
      </Button>
    </LocalizedLink>
  </div>
</Layout>
