---
import Layout from '@/layouts/Layout.astro';
import Clever404View from '@/components/navigation/Clever404View.tsx';
import { getTranslations } from '@/lib/i18n';

// Set response status explicitly
Astro.response.status = 404;

// Detect requested locale from URL pathname (e.g. /de/aboutsss -> 'de')
const pathname = Astro.url?.pathname || '';
const firstSegment = pathname.split('/').filter(Boolean)[0];
const currentLang = (firstSegment === 'en' || firstSegment === 'de' || firstSegment === 'es')
  ? firstSegment
  : 'es';

const t = getTranslations(currentLang);
---

<Layout
  title={t("notFound.title", "404: ¡Se nos ha roto el volteo! | tortilladepatatas.org")}
  description={t("notFound.description", "La página que buscas sobre la tortilla de patatas no se encuentra disponible.")}
  lang={currentLang}
  noindex={true}
>
  <div class="container mx-auto px-4 py-8">
    <Clever404View lang={currentLang} requestedPath={pathname} client:load />
  </div>
</Layout>

