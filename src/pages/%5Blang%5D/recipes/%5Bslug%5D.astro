---
import Layout from '@/layouts/Layout.astro';
import RecipeImage from '@/components/recipes/RecipeImage';
import DownloadCooklangButton from '@/components/recipes/DownloadCooklangButton';
import DownloadPdfButton from '@/components/recipes/DownloadPdfButton';
import ShareButtons from '@/components/share/ShareButtons';
import RecipeIngredientsView from '@/components/recipes/RecipeIngredientsView';
import RecipeStepsView from '@/components/recipes/RecipeStepsView';
import LocalizedLink from '@/components/navigation/LocalizedLink';
import Clever404View from '@/components/navigation/Clever404View.tsx';
import { getAllRecipes, resolveRecipeBadges, getAllTaxonomies, getTaxonomyRoutePrefix } from '@/lib/taxonomy';
import { supportedLanguages, getTranslations } from '@/lib/i18n';
import { generateBreadcrumbSchema, SITE_URL } from '@/lib/seo';
import { createRecipeSchema } from '@/lib/seo/recipeSchema';
import { Clock, Users, BookOpen, ExternalLink, Shield, ChefHat, Sparkles } from 'lucide-react';
import { assertEntityExists } from '@/lib/routing/assertEntity';
import { getRelatedRecipes, getRelatedIngredients, getRelatedTaxonomies } from '@/lib/content/related';
import CulinaryJourneyProgress from '@/components/navigation/CulinaryJourneyProgress.tsx';
import InterconnectedKnowledgeHub from '@/components/navigation/InterconnectedKnowledgeHub.tsx';

export async function getStaticPaths() {
  const recipes = await getAllRecipes();
  const languages = supportedLanguages;
  const paths = [];

  for (const lang of languages) {
    for (const r of recipes) {
      const localizedSlug = r.slug[lang as keyof typeof r.slug] || r.slug.es;
      if (localizedSlug) {
        paths.push({
          params: {
            lang,
            slug: localizedSlug,
          },
          props: {
            recipe: r,
            lang,
          },
        });
      }
    }
  }

  return paths;
}

const { recipe, lang } = Astro.props;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de')
  ? lang
  : (Astro.params.lang === 'en' || Astro.params.lang === 'de' ? Astro.params.lang : 'es');

const t = getTranslations(currentLang);

// Validate content entity existence - sets Astro.response.status = 404 when invalid
const isValidRoute = assertEntityExists(Astro, recipe);

const title = isValidRoute && recipe
  ? (recipe.title[currentLang as keyof typeof recipe.title] || recipe.title.es)
  : t("notFound.subheading", "Receta no encontrada");

const description = isValidRoute && recipe
  ? (recipe.description[currentLang as keyof typeof recipe.description] || recipe.description.es)
  : t("notFound.description", "La receta solicitada no existe.");

const badges = (isValidRoute && recipe) ? await resolveRecipeBadges(recipe.taxonomyIds, currentLang) : [];

const currentUrl = isValidRoute ? `${SITE_URL}/${currentLang}/recipes/${Astro.params.slug}` : undefined;

const breadcrumbsList = isValidRoute ? [
  { name: currentLang === 'de' ? 'Startseite' : currentLang === 'en' ? 'Home' : 'Inicio', url: `/${currentLang}` },
  { name: currentLang === 'de' ? 'Rezepte' : currentLang === 'en' ? 'Recipes' : 'Recetas', url: `/${currentLang}/recipes` },
  { name: title, url: `/${currentLang}/recipes/${Astro.params.slug}` },
] : [];

const breadcrumbSchema = isValidRoute ? generateBreadcrumbSchema(breadcrumbsList) : undefined;

const ingredientsList = isValidRoute && recipe?.ingredients 
  ? recipe.ingredients.map((i) => {
      if (typeof i === 'string') return i;
      const note = i.notes ? (i.notes[currentLang as keyof typeof i.notes] || i.notes.es) : undefined;
      if (note) return note;
      const name = i.name[currentLang as keyof typeof i.name] || i.name.es;
      return `${i.amount}${i.unit === 'unit' ? '' : i.unit} ${name}`;
    })
  : [];

const instructionsList = isValidRoute && recipe?.instructions
  ? recipe.instructions.map((inst) => ({
      step: inst.step[currentLang as keyof typeof inst.step] || inst.step.es,
      text: inst.text[currentLang as keyof typeof inst.text] || inst.text.es,
    }))
  : [];

const recipeSchema = (isValidRoute && recipe) ? createRecipeSchema(recipe, {
  lang: currentLang as 'es' | 'en' | 'de',
  url: currentUrl,
}) : undefined;

const schemas = isValidRoute ? [breadcrumbSchema, recipeSchema].filter(Boolean) : undefined;

const recipeHreflangs = (isValidRoute && recipe) ? supportedLanguages.map((l) => ({
  lang: l,
  href: `${SITE_URL}/${l}/recipes/${recipe.slug[l as keyof typeof recipe.slug] || recipe.slug.es}`,
})) : undefined;

if (isValidRoute && recipe && recipeHreflangs) {
  recipeHreflangs.push({
    lang: 'x-default',
    href: `${SITE_URL}/es/recipes/${recipe.slug.es}`,
  });
}

const pageTitle = isValidRoute ? `${title} - Receta | tortilladepatatas.org` : `404: ${title} | tortilladepatatas.org`;

const rawRecipeInput = (isValidRoute && recipe) ? {
  name: title,
  description: description,
  prepTimeMinutes: recipe.prepTimeMinutes || 15,
  cookTimeMinutes: recipe.cookTimeMinutes || (recipe.time ? Math.max(0, recipe.time - 15) : 20),
  yieldServings: recipe.yieldServings || 4,
  category: 'Main Course',
  cuisine: 'Spanish',
  authorName: recipe.author?.name || 'tortilladepatatas.org',
  url: currentUrl,
  ingredients: ingredientsList,
  instructions: instructionsList,
} : undefined;

const relatedRecipes = (isValidRoute && recipe) ? await getRelatedRecipes({ type: 'recipe', id: recipe.id, taxonomyIds: recipe.taxonomyIds }, currentLang) : [];
const relatedIngredients = (isValidRoute && recipe) ? await getRelatedIngredients(recipe, currentLang) : [];
const relatedTaxonomies = (isValidRoute && recipe) ? await getRelatedTaxonomies(recipe, currentLang) : [];

// Linked Chef / Persona Profile
const allTaxonomies = await getAllTaxonomies();
const personaFavorited = (isValidRoute && recipe)
  ? allTaxonomies.find((t) => t.type === 'person' && (t as any).favoriteRecipe === recipe.id)
  : undefined;

const personaAny = personaFavorited as any;
const personaName = personaFavorited
  ? (personaAny.name || (personaFavorited.title[currentLang as keyof typeof personaFavorited.title] || personaFavorited.title.es))
  : undefined;

const personaRole = personaFavorited
  ? (typeof personaAny.role === 'object'
      ? (personaAny.role[currentLang] || personaAny.role.es)
      : personaAny.role)
  : undefined;

const personaQuote = personaFavorited
  ? (personaAny.quote
      ? (personaAny.quote[currentLang] || personaAny.quote.es)
      : undefined)
  : undefined;

const personaSlug = personaFavorited
  ? (personaFavorited.slug[currentLang as keyof typeof personaFavorited.slug] || personaFavorited.slug.es)
  : undefined;

const personaUrl = personaFavorited
  ? `/${currentLang}/${getTaxonomyRoutePrefix('person', currentLang)}/${personaSlug}`
  : undefined;

const personaImage = personaFavorited
  ? (personaAny.image ? String(personaAny.image).replace(/\.jpg$/, '.svg') : '/images/personas/cocineras.svg')
  : undefined;
---

<Layout title={pageTitle} description={description} lang={currentLang} schema={schemas} breadcrumbs={breadcrumbsList} customHreflangs={recipeHreflangs} canonical={currentUrl}>
  {!isValidRoute || !recipe ? (
    <div class="container mx-auto px-4 py-8">
      <Clever404View lang={currentLang} requestedPath={Astro.url.pathname} client:load />
    </div>
  ) : (
    <article itemscope itemtype="https://schema.org/Recipe" class="container mx-auto px-4 py-10 md:py-16 max-w-4xl space-y-10">
      <!-- HIDDEN METADATA FOR CRAWLERS -->
      <meta itemprop="prepTime" content={`PT${recipe.prepTimeMinutes || 15}M`} />
      <meta itemprop="cookTime" content={`PT${recipe.cookTimeMinutes || 20}M`} />
      <meta itemprop="totalTime" content={`PT${recipe.time || 35}M`} />
      <meta itemprop="recipeCategory" content="Main Course" />
      <meta itemprop="recipeCuisine" content="Spanish" />

      <!-- HEADER -->
      <header class="space-y-4 text-center">
        <div class="flex flex-wrap justify-center gap-2">
          {badges.map((b) => (
            <a
              href={b.url}
              class="inline-flex items-center gap-1 text-xs font-bold bg-[#FFB800]/15 dark:bg-[#FFB800]/20 text-[#8D6E63] dark:text-[#FFB800] hover:bg-[#FFB800]/25 px-3 py-1 rounded-full border border-[#FFB800]/30 transition-colors shadow-2xs"
            >
              <span class="capitalize text-muted-foreground text-[10px]">{b.type}:</span>
              <span>{b.title}</span>
            </a>
          ))}
        </div>

        <h1 itemprop="name" class="text-3xl sm:text-4xl md:text-5xl font-serif-heading font-extrabold text-foreground tracking-tight">
          {title}
        </h1>

        <p itemprop="description" class="text-base sm:text-lg text-muted-foreground leading-relaxed max-w-2xl mx-auto">
          {description}
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs font-bold text-foreground pt-2">
          <div class="flex items-center gap-1.5 bg-card px-3 py-1.5 rounded-xl border border-border shadow-2xs">
            <Clock class="w-4 h-4 text-[#FFB800]" />
            <span><time datetime={`PT${recipe.time || 35}M`}>{recipe.time} min {currentLang === 'es' ? 'tiempo total' : currentLang === 'de' ? 'Gesamtzeit' : 'total time'}</time></span>
          </div>
          <div class="flex items-center gap-1.5 bg-card px-3 py-1.5 rounded-xl border border-border shadow-2xs">
            <Users class="w-4 h-4 text-[#FFB800]" />
            <span itemprop="recipeYield">{currentLang === 'es' ? '4 comensales (ajustable)' : currentLang === 'de' ? '4 Portionen (anpassbar)' : '4 servings (scalable)'}</span>
          </div>
          <div class="flex items-center gap-1.5 bg-[#FFB800]/10 dark:bg-[#FFB800]/15 px-3 py-1.5 rounded-xl border border-[#FFB800]/30 text-foreground shadow-2xs">
            <Shield class="w-4 h-4 text-[#2E7D32]" />
            <span>{currentLang === 'es' ? 'Estándar: ' : currentLang === 'de' ? 'Standard: ' : 'Standard: '}<strong>70°C for 2 minutes</strong></span>
          </div>
          {rawRecipeInput && (
            <DownloadPdfButton
              client:load
              recipe={rawRecipeInput}
              lang={currentLang}
              filename={Astro.params.slug}
              className="bg-[#2E7D32]/10 hover:bg-[#2E7D32]/20 text-[#2E7D32] dark:text-[#81C784] border border-[#2E7D32]/30 font-bold text-xs shadow-2xs"
            />
          )}
          {rawRecipeInput && (
            <DownloadCooklangButton
              client:load
              recipe={rawRecipeInput}
              lang={currentLang}
              filename={Astro.params.slug}
              className="bg-accent hover:bg-[#FFB800]/20 text-foreground border border-border font-bold text-xs shadow-2xs"
            />
          )}
          <ShareButtons
            client:load
            url={currentUrl}
            title={title}
            description={description}
            lang={currentLang}
            variant="compact"
            showUrlNotice={false}
          />
        </div>

        <!-- SOURCES & AUTHORSHIP ATTRIBUTION -->
        {(recipe.sources?.length || recipe.author) && (
          <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-muted-foreground bg-accent p-3.5 rounded-xl border border-border max-w-2xl mx-auto shadow-2xs">
            {recipe.author && (
              <div itemprop="author" itemscope itemtype="https://schema.org/Organization" class="flex items-center gap-1.5 font-medium">
                <span>Publicado por:</span>
                <span itemprop="name" class="font-bold text-foreground">{recipe.author.name}</span>
              </div>
            )}
            {recipe.sources && recipe.sources.map((src) => (
              <div class="flex flex-wrap items-center gap-1.5 font-medium border-l border-border pl-3 first:border-l-0 first:pl-0">
                <span class="capitalize">Origen ({src.type}):</span>
                <span class="font-bold text-foreground">{src.name}</span>
                {src.description && (
                  <span class="italic">
                    — {src.description[currentLang as keyof typeof src.description] || src.description.es}
                  </span>
                )}
              </div>
            ))}
          </div>
        )}
      </header>

      <!-- RECIPE HERO IMAGE -->
      <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject" class="card-notebook overflow-hidden rounded-2xl border border-border bg-muted h-48 sm:h-64 md:h-80 max-h-[35vh] relative shadow-xs">
        <meta itemprop="url" content={`${SITE_URL}${recipe.image ? recipe.image.replace(/\.jpg$/, '.svg') : '/images/recipes/clasica.svg'}`} />
        <RecipeImage
          client:load
          src={recipe.image}
          recipeId={recipe.id}
          title={title}
          ingredients={recipe.ingredients}
          taxonomyIds={recipe.taxonomyIds}
          className="w-full h-full object-cover"
        />
      </div>

      <!-- CHEF'S CHOICE / PERSONA STORY CALLOUT -->
      {personaFavorited && (
        <section class="card-notebook p-5 sm:p-7 rounded-2xl border border-border bg-card shadow-xs flex flex-col sm:flex-row items-center gap-5 justify-between">
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden border-2 border-[#FFB800] shrink-0 shadow-xs">
              <img
                src={personaImage}
                alt={personaName}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="space-y-1">
              <span class="inline-flex items-center gap-1 text-[11px] font-extrabold uppercase tracking-wider text-[#8D6E63] dark:text-[#FFB800] bg-[#FFB800]/15 px-2.5 py-0.5 rounded-full border border-[#FFB800]/30">
                <ChefHat class="w-3 h-3 text-[#FFB800]" />
                <span>{currentLang === 'en' ? "Chef's Choice & Companion Story" : currentLang === 'de' ? "Empfehlung der Meister & Geschichte" : "Elección del Maestro y Relato Personal"}</span>
              </span>
              <h3 class="text-base sm:text-lg font-serif-heading font-bold text-foreground">
                {personaName} {personaRole && <span class="text-xs text-muted-foreground font-sans font-normal">({personaRole})</span>}
              </h3>
              {personaQuote && (
                <p class="text-xs italic text-muted-foreground line-clamp-2 max-w-xl">
                  &ldquo;{personaQuote}&rdquo;
                </p>
              )}
            </div>
          </div>
          <a
            href={personaUrl}
            class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#FFB800] hover:bg-amber-400 text-[#1C1917] text-xs font-bold shadow-2xs transition-colors whitespace-nowrap"
          >
            <span>{currentLang === 'en' ? `Read ${personaName}'s Story` : currentLang === 'de' ? `Geschichte von ${personaName} lesen` : `Leer la historia de ${personaName}`}</span>
            <span>→</span>
          </a>
        </section>
      )}

      <!-- INGREDIENTS & INSTRUCTIONS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
        <!-- INGREDIENTS SIDEBAR WITH INTERACTIVE SERVING SCALER -->
        <div class="md:col-span-1">
          <RecipeIngredientsView
            client:load
            recipe={recipe}
            lang={currentLang}
            initialServings={4}
          />
        </div>

        <!-- STEP BY STEP INSTRUCTIONS WITH INTERACTIVE COOKING PROGRESS -->
        <div class="md:col-span-2">
          <RecipeStepsView
            client:load
            instructions={instructionsList}
            lang={currentLang}
            recipeTime={recipe.time || 35}
          />
        </div>
      </div>

      <!-- SHARE TO & URL SAVE SECTION -->
      <section class="pt-2">
        <ShareButtons
          client:visible
          url={currentUrl}
          title={title}
          description={description}
          lang={currentLang}
          variant="card"
          showUrlNotice={true}
        />
      </section>

      <!-- RELATED INGREDIENTS & VARIATIONS -->
      {relatedIngredients.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-border">
          <h2 class="text-xl sm:text-2xl font-serif-heading font-bold text-foreground">
            {currentLang === 'en' ? 'Key Ingredients' : currentLang === 'de' ? 'Hauptzutaten' : 'Ingredientes Clave'}
          </h2>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
            {relatedIngredients.map((ing) => (
              <a href={ing.url} class="card-notebook p-4 rounded-xl bg-card border border-border hover:border-[#FFB800] transition-colors flex items-center gap-3">
                <span class="text-lg">🥔</span>
                <div>
                  <h3 class="font-bold text-sm text-foreground">{ing.title}</h3>
                  <span class="text-xs text-muted-foreground line-clamp-1">{ing.description || ing.title}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {relatedRecipes.length > 0 && (
        <section class="space-y-4 pt-6 border-t border-border">
          <h2 class="text-xl sm:text-2xl font-serif-heading font-bold text-foreground">
            {currentLang === 'en' ? 'Related Variations' : currentLang === 'de' ? 'Verwandte Rezepte' : 'Variaciones Relacionadas'}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedRecipes.map((r) => (
              <a href={r.url} class="card-notebook p-4 rounded-xl bg-card border border-border hover:border-[#FFB800] transition-colors space-y-1.5">
                <h3 class="font-bold text-sm text-foreground">{r.title}</h3>
                <p class="text-xs text-muted-foreground line-clamp-2">{r.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Interconnected Knowledge Base Node */}
      <InterconnectedKnowledgeHub lang={currentLang} currentPath={`/${currentLang}/recipes/${Astro.params.slug}`} client:visible />

      <!-- Linear Guided Culinary Journey -->
      <CulinaryJourneyProgress lang={currentLang} currentStepPath={`/${currentLang}/recipes`} client:visible />
    </article>
  )}
</Layout>
