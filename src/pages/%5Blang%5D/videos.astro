---
import Layout from '@/layouts/Layout.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent } from '@/components/ui/card';
import { Film, PlaySquare, Sparkles, ChefHat, Flame, Users, History, FlaskConical, Video } from 'lucide-react';
import { getTranslations, supportedLanguages } from '@/lib/i18n';
import { generateBreadcrumbSchema, generateArticleSchema } from '@/lib/seo';
import { getCollection } from 'astro:content';
import VideoGrid from '@/components/videos/VideoGrid.tsx';
import CulinaryJourneyProgress from '@/components/navigation/CulinaryJourneyProgress.tsx';
import InterconnectedKnowledgeHub from '@/components/navigation/InterconnectedKnowledgeHub.tsx';

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';
const t = getTranslations(currentLang);

// Fetch videos collection
const videoEntries = await getCollection('videos');
const videoItems = videoEntries.map((v) => ({
  id: v.data.id,
  title: v.data.title,
  description: v.data.description,
  videoId: v.data.videoId,
  thumbnailUrl: v.data.thumbnailUrl,
  duration: v.data.duration,
  lang: v.data.lang,
  category: v.data.category,
  relatedRecipeIds: v.data.relatedRecipeIds,
  publishedAt: v.data.publishedAt,
}));

const pageTitles = {
  es: "Videoteca & Masterclasses de Tortilla de Patatas",
  en: "Video Library & Masterclasses - Spanish Tortilla",
  de: "Videothek & Meisterklassen - Spanische Tortilla",
};

const pageDescriptions = {
  es: "Aprende las técnicas maestras de volteo, entrevistas a chefs y abuelas, documentales históricos y análisis científico en vídeo de alta definición.",
  en: "Learn master flip techniques, chef and grandmother interviews, historical documentaries, and high-definition food science tutorials.",
  de: "Lerne Meistertechniken des Wendens, Interviews mit Spitzenköchen und Großmüttern, Geschichtsdokumentationen und wissenschaftliche Video-Tutorials.",
};

const title = `${pageTitles[currentLang]} - tortilladepatatas.org`;
const description = pageDescriptions[currentLang];

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: currentLang === 'en' ? 'Home' : currentLang === 'de' ? 'Startseite' : 'Inicio', url: `/${currentLang}` },
  { name: pageTitles[currentLang], url: `/${currentLang}/videos` }
]);

const articleSchema = generateArticleSchema({
  headline: pageTitles[currentLang],
  description: pageDescriptions[currentLang],
  url: `/${currentLang}/videos`,
});

const schemas = [breadcrumbSchema, articleSchema];

const pageLabels = {
  es: {
    heroBadge: "Producción Audiovisual & Masterclasses 4K",
    heroTitle: "Videoteca Culinaria & Documentales",
    heroSubtitle: "Técnicas de volteo en cámara lenta, entrevistas con leyendas del fogón, crónicas históricas y termodinámica del huevo explicada paso a paso.",
    statsVideos: "8 Producciones",
    statsQuality: "Formato 4K Ultra HD",
    statsAccess: "Acceso Libre & Didáctico",
    bannerTitle: "El Proyecto Audiovisual de tortilladepatatas.org",
    bannerDesc: "Estamos rodando y catalogando minuciosamente cada técnica ancestral y vanguardista junto a maestros de toda la península ibérica.",
  },
  en: {
    heroBadge: "Audiovisual Production & 4K Masterclasses",
    heroTitle: "Culinary Video Library & Documentaries",
    heroSubtitle: "Slow-motion flipping techniques, interviews with master chefs and grandmothers, historical chronicles, and egg thermodynamics explained step by step.",
    statsVideos: "8 Productions",
    statsQuality: "4K Ultra HD Format",
    statsAccess: "Open & Educational Access",
    bannerTitle: "The tortilladepatatas.org Audiovisual Initiative",
    bannerDesc: "We are currently shooting and archiving every traditional and modern technique with master chefs across Spain.",
  },
  de: {
    heroBadge: "Audiovisuelle Produktion & 4K-Meisterklassen",
    heroTitle: "Kulinarische Videothek & Dokumentationen",
    heroSubtitle: "Zeitlupen-Wende-Techniken, Interviews mit Kochlegenden und Großmüttern, historische Chroniken und Ei-Thermodynamik Schritt für Schritt erklärt.",
    statsVideos: "8 Produktionen",
    statsQuality: "4K Ultra HD Format",
    statsAccess: "Freier & Didaktischer Zugang",
    bannerTitle: "Das audiovisuelle Projekt von tortilladepatatas.org",
    bannerDesc: "Wir drehen und katalogisieren jede traditionelle und moderne Technik gemeinsam mit Spitzenköchen in ganz Spanien.",
  },
}[currentLang];
---

<Layout title={title} description={description} lang={currentLang} schema={schemas}>
  <div class="container mx-auto px-4 py-8 md:py-12 max-w-7xl space-y-10">
    
    <!-- Hero Banner -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <Badge variant="secondary" class="px-3.5 py-1 text-xs font-bold bg-[#FFB800]/15 dark:bg-[#FFB800]/20 text-[#8D6E63] dark:text-[#FFB800] border border-[#FFB800]/30 inline-flex items-center gap-1.5 shadow-2xs">
        <Film class="w-3.5 h-3.5 text-[#FFB800]" />
        <span>{pageLabels.heroBadge}</span>
      </Badge>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif-heading font-black tracking-tight text-foreground leading-tight">
        {pageLabels.heroTitle}
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        {pageLabels.heroSubtitle}
      </p>

      {/* Feature Highlights */}
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full bg-accent border border-border text-foreground">
          <Video class="w-3.5 h-3.5 text-[#FFB800]" />
          {pageLabels.statsVideos}
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full bg-accent border border-border text-foreground">
          <Sparkles class="w-3.5 h-3.5 text-[#FFB800]" />
          {pageLabels.statsQuality}
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-bold px-3 py-1 rounded-full bg-accent border border-border text-foreground">
          <ChefHat class="w-3.5 h-3.5 text-[#FFB800]" />
          {pageLabels.statsAccess}
        </span>
      </div>
    </header>

    <!-- Interactive Video Grid Component -->
    <section aria-label={pageLabels.heroTitle}>
      <VideoGrid videos={videoItems} lang={currentLang} client:load />
    </section>

    <!-- Production Context Card -->
    <Card class="card-notebook bg-gradient-to-br from-card to-accent border-2 border-border shadow-stacked-parchment overflow-hidden">
      <CardContent class="p-6 sm:p-8 space-y-4">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-border pb-4">
          <div class="flex items-center gap-3">
            <div class="p-2.5 rounded-xl bg-[#FFB800] text-[#1C1917] shadow-sm">
              <PlaySquare class="w-6 h-6" />
            </div>
            <div>
              <h2 class="font-serif-heading font-bold text-lg sm:text-xl text-foreground">
                {pageLabels.bannerTitle}
              </h2>
              <p class="text-xs sm:text-sm text-muted-foreground">
                {pageLabels.bannerDesc}
              </p>
            </div>
          </div>
          <a
            href={`/${currentLang}/recipes`}
            class="px-4 py-2 bg-[#8D6E63] hover:bg-[#73564B] dark:bg-[#FFB800] dark:hover:bg-[#E0A200] text-white dark:text-[#1C1917] text-xs font-bold rounded-xl transition-colors shadow-2xs shrink-0 inline-flex items-center gap-1.5"
          >
            <ChefHat class="w-3.5 h-3.5" />
            <span>{currentLang === 'en' ? 'Explore Recipes' : currentLang === 'de' ? 'Rezepte entdecken' : 'Explorar Recetario'}</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 pt-2 text-xs">
          <div class="p-3 rounded-xl bg-card border border-border space-y-1">
            <div class="flex items-center gap-1.5 font-bold text-[#8D6E63] dark:text-[#FFB800]">
              <Flame class="w-4 h-4" />
              <span>{currentLang === 'en' ? 'Techniques' : currentLang === 'de' ? 'Techniken' : 'Técnicas'}</span>
            </div>
            <p class="text-muted-foreground">{currentLang === 'en' ? 'Mastering the flick, confit temperature and pan seasoning.' : currentLang === 'de' ? 'Wenden, Confieren und Pfannenpflege.' : 'Dominio del volteo, confitado y curado de sartenes.'}</p>
          </div>

          <div class="p-3 rounded-xl bg-card border border-border space-y-1">
            <div class="flex items-center gap-1.5 font-bold text-[#8D6E63] dark:text-[#FFB800]">
              <Users class="w-4 h-4" />
              <span>{currentLang === 'en' ? 'Interviews' : currentLang === 'de' ? 'Interviews' : 'Entrevistas'}</span>
            </div>
            <p class="text-muted-foreground">{currentLang === 'en' ? 'Insights from Michelin chefs to abuelas in rural taverns.' : currentLang === 'de' ? 'Von Michelin-Köchen bis zu Großmüttern in Tavernen.' : 'De chefs galardonados a abuelas de taberna tradicional.'}</p>
          </div>

          <div class="p-3 rounded-xl bg-card border border-border space-y-1">
            <div class="flex items-center gap-1.5 font-bold text-[#8D6E63] dark:text-[#FFB800]">
              <History class="w-4 h-4" />
              <span>{currentLang === 'en' ? 'History' : currentLang === 'de' ? 'Geschichte' : 'Historia'}</span>
            </div>
            <p class="text-muted-foreground">{currentLang === 'en' ? 'Archival investigations into 18th-century manuscripts.' : currentLang === 'de' ? 'Archivrecherchen zu Manuskripten des 18. Jahrhunderts.' : 'Investigaciones de archivos y manuscritos del siglo XVIII.'}</p>
          </div>

          <div class="p-3 rounded-xl bg-card border border-border space-y-1">
            <div class="flex items-center gap-1.5 font-bold text-[#8D6E63] dark:text-[#FFB800]">
              <FlaskConical class="w-4 h-4" />
              <span>{currentLang === 'en' ? 'Science & Safety' : currentLang === 'de' ? 'Wissenschaft & Sicherheit' : 'Ciencia & Seguridad'}</span>
            </div>
            <p class="text-muted-foreground">
              {currentLang === 'es'
                ? 'Física térmica, curvas de coagulación proteica y experimentos de laboratorio culinario.'
                : currentLang === 'de'
                ? 'Thermophysik, Proteinstockung und kulinarische Labordemonstrationen.'
                : 'Thermal physics, protein coagulation curves, and culinary laboratory demonstrations.'}
            </p>
          </div>
        </div>
      </CardContent>
    </Card>

    {/* Interconnected Knowledge Base Node */}
    <InterconnectedKnowledgeHub lang={currentLang} currentPath={`/${currentLang}/videos`} client:visible />

    <!-- Guided Culinary Journey Navigation -->
    <CulinaryJourneyProgress lang={currentLang} currentStepPath={`/${currentLang}/videos`} client:visible />

  </div>
</Layout>
