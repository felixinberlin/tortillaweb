---
import Layout from '@/layouts/Layout.astro';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import RecipeImage from '@/components/recipes/RecipeImage';
import DownloadCooklangButton from '@/components/recipes/DownloadCooklangButton';
import LocalizedLink from '@/components/navigation/LocalizedLink';
import { BookOpen, Sparkles, Clock, ExternalLink } from 'lucide-react';
import { getTranslations, supportedLanguages } from '@/lib/i18n';
import { generateRecipeSchema, generateBreadcrumbSchema, generateCollectionPageSchema, SITE_URL } from '@/lib/seo';
import { getAllRecipes, resolveRecipeBadges } from '@/lib/taxonomy';

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';
const t = getTranslations(currentLang);

// Get all recipes from Content Collections
const recipes = await getAllRecipes();

// Resolve badges for each recipe
const recipesWithBadges = await Promise.all(
  recipes.map(async (r) => ({
    ...r,
    badges: await resolveRecipeBadges(r.taxonomyIds, currentLang),
  }))
);

const title = `${t('recipes.title')} - tortilladepatatas.org`;
const description = t('recipes.subtitle');

const recipeSchemas = recipes.map((r) => {
  const rTitle = r.title[currentLang as keyof typeof r.title] || r.title.es;
  const rDesc = r.description[currentLang as keyof typeof r.description] || r.description.es;
  const rSlug = r.slug[currentLang as keyof typeof r.slug] || r.slug.es;
  const rUrl = `${SITE_URL}/${currentLang}/recipes/${rSlug}`;

  const ingredientsList = r.ingredients
    ? r.ingredients.map((i) => {
        if (typeof i === 'string') return i;
        const note = i.notes ? (i.notes[currentLang as keyof typeof i.notes] || i.notes.es) : undefined;
        if (note) return note;
        const name = i.name[currentLang as keyof typeof i.name] || i.name.es;
        return `${i.amount}${i.unit === 'unit' ? '' : i.unit} ${name}`;
      })
    : [
        '600g Patatas Agria o Monalisa',
        '6 Huevos camperos frescos (Tamaño L)',
        '150ml Aceite de oliva virgen extra',
        '6g Sal fina'
      ];

  const instructionsList = r.instructions
    ? r.instructions.map((inst) => ({
        step: inst.step[currentLang as keyof typeof inst.step] || inst.step.es,
        text: inst.text[currentLang as keyof typeof inst.text] || inst.text.es,
      }))
    : [
        { step: 'Cortar patatas', text: 'Pelar y cortar las patatas en láminas finas.' },
        { step: 'Confitar patatas', text: 'Confitar en aceite de oliva a fuego medio-bajo (130-140°C).' },
        { step: 'Mezclar con huevo', text: 'Batir los huevos con la sal y agregar las patatas.' },
        { step: 'Cuajar y voltear', text: 'Cuajar a fuego suave-medio hasta lograr el punto de cremosidad ideal.' }
      ];

  return generateRecipeSchema({
    name: rTitle,
    description: rDesc,
    image: r.image || '/images/recipes/clasica.jpg',
    prepTimeMinutes: r.prepTimeMinutes || 15,
    cookTimeMinutes: r.cookTimeMinutes || 20,
    yieldServings: r.yieldServings || 4,
    authorName: r.author?.name || 'tortilladepatatas.org',
    ingredients: ingredientsList,
    instructions: instructionsList,
    url: rUrl,
  });
});

const collectionSchema = generateCollectionPageSchema({
  name: t('recipes.title'),
  description: t('recipes.subtitle'),
  url: `${SITE_URL}/${currentLang}/recipes`,
  items: recipes.map((r) => ({
    name: r.title[currentLang as keyof typeof r.title] || r.title.es,
    url: `${SITE_URL}/${currentLang}/recipes/${r.slug[currentLang as keyof typeof r.slug] || r.slug.es}`,
  })),
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `/${currentLang}` },
  { name: t('recipes.title'), url: `/${currentLang}/recipes` }
]);

const schemas = [collectionSchema, breadcrumbSchema, ...recipeSchemas];
---

<Layout title={title} description={description} lang={currentLang} schema={schemas}>
  <main itemscope itemtype="https://schema.org/CollectionPage" class="container mx-auto px-4 py-10 md:py-16 max-w-6xl space-y-10">
    <header class="text-center max-w-3xl mx-auto space-y-3">
      <Badge variant="secondary" class="mb-2 px-3.5 py-1 text-xs font-bold bg-[#FFB800]/15 dark:bg-[#FFB800]/20 text-[#8D6E63] dark:text-[#FFB800] border border-[#FFB800]/30 inline-flex items-center gap-1.5 shadow-2xs">
        <BookOpen class="w-3.5 h-3.5 text-[#FFB800]" />
        {t("nav.recipes", "Recetas de la Gastronomía")}
      </Badge>
      <h1 itemprop="name" class="text-3xl sm:text-4xl md:text-5xl font-serif-heading font-extrabold tracking-tight text-foreground">
        {t('recipes.title')}
      </h1>
      <p itemprop="description" class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        {t('recipes.subtitle')}
      </p>
    </header>

    <section itemscope itemtype="https://schema.org/ItemList" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {recipesWithBadges.map((r, index) => {
        const rTitle = r.title[currentLang as keyof typeof r.title] || r.title.es;
        const rDesc = r.description[currentLang as keyof typeof r.description] || r.description.es;
        const rSlug = r.slug[currentLang as keyof typeof r.slug] || r.slug.es;

        return (
          <article itemprop="itemListElement" itemscope itemtype="https://schema.org/Recipe" key={r.id} class="card-notebook overflow-hidden rounded-2xl border border-border bg-card hover:border-[#FFB800] transition-all duration-300 flex flex-col justify-between group">
            <meta itemprop="position" content={`${index + 1}`} />
            <meta itemprop="url" content={`${SITE_URL}/${currentLang}/recipes/${rSlug}`} />
            <div>
              <div itemprop="image" itemscope itemtype="https://schema.org/ImageObject" class="h-44 sm:h-48 w-full overflow-hidden bg-muted relative border-b border-border">
                <meta itemprop="url" content={`${SITE_URL}${r.image || '/images/recipes/clasica.jpg'}`} />
                <RecipeImage
                  client:visible
                  src={r.image}
                  recipeId={r.id}
                  title={rTitle}
                  ingredients={r.ingredients}
                  taxonomyIds={r.taxonomyIds}
                  className="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <div class="absolute top-3 right-3 bg-card/90 dark:bg-[#1C1917]/90 border border-border text-foreground text-[11px] font-bold px-2.5 py-1 rounded-full shadow-2xs flex items-center gap-1 backdrop-blur-xs">
                  <Clock class="w-3 h-3 text-[#FFB800]" />
                  <span><time datetime={`PT${r.time || 35}M`}>{r.time} min</time></span>
                </div>
              </div>

              <div class="p-5 space-y-3">
                <h2 itemprop="name" class="text-xl font-serif-heading font-bold text-foreground group-hover:text-[#8D6E63] dark:group-hover:text-[#FFB800] transition-colors">
                  <a href={`/${currentLang}/recipes/${rSlug}`}>
                    {rTitle}
                  </a>
                </h2>

                <p itemprop="description" class="text-xs sm:text-sm text-muted-foreground leading-relaxed line-clamp-3">
                  {rDesc}
                </p>

                <!-- TAXONOMY BADGES -->
                <div class="flex flex-wrap gap-1.5 pt-2">
                  {r.badges.map((b) => (
                    <a
                      href={b.url}
                      class="inline-flex items-center gap-1 text-[11px] font-bold bg-accent hover:bg-[#FFB800]/20 text-foreground px-2 py-0.5 rounded-md border border-border transition-colors"
                    >
                      <span>{b.title}</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="p-5 pt-0 mt-auto flex items-center justify-between gap-2 border-t border-border pt-3">
              <a
                href={`/${currentLang}/recipes/${rSlug}`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8D6E63] dark:text-[#FFB800] hover:underline transition-colors"
              >
                <Sparkles class="w-3.5 h-3.5 text-[#FFB800]" />
                <span>Ver Receta</span>
                <ExternalLink class="w-3 h-3" />
              </a>

              <DownloadCooklangButton
                client:visible
                recipe={{
                  name: rTitle,
                  description: rDesc,
                  prepTimeMinutes: r.prepTimeMinutes || 15,
                  cookTimeMinutes: r.cookTimeMinutes || 20,
                  yieldServings: r.yieldServings || 4,
                  authorName: r.author?.name || 'tortilladepatatas.org',
                  url: `${SITE_URL}/${currentLang}/recipes/${rSlug}`,
                  ingredients: r.ingredients ? r.ingredients.map((i) => typeof i === 'string' ? i : `${i.amount}${i.unit === 'unit' ? '' : i.unit} ${i.name[currentLang as keyof typeof i.name] || i.name.es}`) : [],
                  instructions: r.instructions ? r.instructions.map((i) => ({ step: i.step[currentLang as keyof typeof i.step] || i.step.es, text: i.text[currentLang as keyof typeof i.text] || i.text.es })) : [],
                }}
                lang={currentLang}
                filename={rSlug}
                size="sm"
                variant="outline"
                className="bg-accent hover:bg-[#FFB800]/20 text-foreground border border-border font-bold text-[11px] h-7 px-2"
              />
            </div>
          </article>
        );
      })}
    </section>

    <!-- Kitchen Tools & Utensils Educational Banner -->
    <section class="card-notebook p-6 sm:p-8 bg-gradient-to-br from-amber-500/10 via-amber-500/5 to-transparent border-2 border-[#FFB800]/40 rounded-3xl shadow-stacked-parchment flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFB800]/20 text-[#8D6E63] dark:text-[#FFB800] text-xs font-bold border border-[#FFB800]/30">
          🍳 {currentLang === 'es' ? 'Guía Técnica de Menaje & Utensilios' : currentLang === 'de' ? 'Technischer Werkzeug- & Pfannen-Guide' : 'Technical Kitchen Tools & Pans Guide'}
        </span>
        <h2 class="text-xl sm:text-2xl font-bold font-serif-heading text-foreground">
          {currentLang === 'es' ? 'Sartenes dobles, peladores en Y y física del menaje' : currentLang === 'de' ? 'Doppel-Wendipfannen, Y-Schäler & Physik des Kochens' : 'Double flip pans, Y-peelers, and kitchen physics'}
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
          {currentLang === 'es'
            ? 'Aprende qué tipo de sartén usar según el número de huevos, por qué los peladores en Y ahorran un 10% de pulpa de patata y cómo medir los 70°C con sonda digital sin alterar la textura.'
            : currentLang === 'de'
            ? 'Erfahren Sie, welche Pfannengröße zu Ihren Eiern passt, warum Y-Schäler 10 % Kartoffelverlust vermeiden und wie Sie 70°C sicher kontrollieren.'
            : 'Learn how to size your skillet to egg volume, why Y-peelers save 10% potato mass, and how to verify 70°C thermal safety with an instant probe.'}
        </p>
      </div>

      <a
        href={`/${currentLang}/utensilios`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-[#8D6E63] hover:bg-[#73564B] dark:bg-[#FFB800] dark:hover:bg-[#E0A200] text-white dark:text-[#1C1917] font-bold text-sm rounded-xl shadow-md transition-all shrink-0"
      >
        <span>{currentLang === 'es' ? 'Leer Guía de Utensilios' : currentLang === 'de' ? 'Zu den Küchenwerkzeugen' : 'Explore Kitchen Tools Guide'}</span>
        <Sparkles class="w-4 h-4 text-[#FFB800] dark:text-[#1C1917]" />
      </a>
    </section>
  </main>
</Layout>
