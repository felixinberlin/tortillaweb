---
import Layout from '@/layouts/Layout.astro';
import { supportedLanguages } from '@/lib/i18n';
import { generateBreadcrumbSchema } from '@/lib/seo';
import PollComponent from '@/components/factions/PollComponent';
import { Vote } from 'lucide-react';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';

const pageTitle = `Encuestas & Plebiscitos Culinarios | tortilladepatatas.org`;
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `/${currentLang}` },
  { name: 'Laboratorio', url: `/${currentLang}/laboratorio` },
  { name: 'Encuestas', url: `/${currentLang}/encuestas` },
]);
---

<Layout title={pageTitle} description="Plebiscitos y encuestas de la comunidad tortillera" lang={currentLang} schema={[breadcrumbSchema]}>
  <div class="container mx-auto px-4 py-10 md:py-16 max-w-4xl space-y-12">
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FFB800]/15 dark:bg-[#FFB800]/20 text-[#8D6E63] dark:text-[#FFB800] border border-[#FFB800]/30 text-xs font-bold shadow-2xs">
        <Vote class="w-3.5 h-3.5 text-[#FFB800]" />
        <span>Plebiscito Culinario Nacional</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif-heading font-extrabold text-foreground">
        Encuestas & Lealtad Culinaria
      </h1>

      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        Participa en las grandes consultas populares sobre cebolla, nivel de cuajado y corte de patata.
      </p>
    </header>

    <div class="card-notebook p-6 sm:p-8 rounded-2xl border border-border bg-card">
      <PollComponent client:load lang={currentLang} />
    </div>
  </div>
</Layout>
