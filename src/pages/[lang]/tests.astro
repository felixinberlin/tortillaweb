---
import Layout from '@/layouts/Layout.astro';
import { supportedLanguages } from '@/lib/i18n';
import { generateBreadcrumbSchema } from '@/lib/seo';
import FactionAffinityQuiz from '@/components/factions/FactionAffinityQuiz';
import { HelpCircle, CheckCircle2, Gamepad2 } from 'lucide-react';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';

const pageTitle = currentLang === 'en'
  ? 'Faction Loyalty Quiz & Orthodoxy Test | tortilladepatatas.org'
  : currentLang === 'de'
  ? 'Fraktionstest & Orthodoxie-Fragebogen | tortilladepatatas.org'
  : 'Test de Ortodoxia & Cuestionario de Facciones | tortilladepatatas.org';

const pageDescription = currentLang === 'en'
  ? 'Interactive faction test determining your culinary allegiance (Onion-lover, Purist, Garlic, Pepper, or Avant-garde) with cookie persistence.'
  : currentLang === 'de'
  ? 'Interaktiver Fraktionstest zur Ermittlung deiner kulinarischen Loyalität mit Cookie-Speicherung.'
  : 'Cuestionario interactivo para determinar matemáticamente tu afinidad culinaria (Concebollista, Purista, Ajista, Pimientista o Con Cosas) con guardado en cookie.';

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `/${currentLang}` },
  { name: 'Laboratorio', url: `/${currentLang}/laboratorio` },
  { name: 'Tests', url: `/${currentLang}/tests` },
]);
---

<Layout title={pageTitle} description={pageDescription} lang={currentLang} schema={[breadcrumbSchema]}>
  <div class="container mx-auto px-4 py-10 md:py-16 max-w-4xl space-y-12">
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#FFB800]/15 dark:bg-[#FFB800]/20 text-[#8D6E63] dark:text-[#FFB800] border border-[#FFB800]/30 text-xs font-bold shadow-2xs">
        <HelpCircle class="w-3.5 h-3.5 text-[#FFB800]" />
        <span>{currentLang === 'en' ? 'Culinary Orthodoxy Test' : currentLang === 'de' ? 'Kulinarischer Orthodoxie-Test' : 'Cuestionario de Ortodoxia Culinaria'}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif-heading font-extrabold text-foreground">
        {currentLang === 'en' ? 'Faction Affinity & Loyalty Test' : currentLang === 'de' ? 'Fraktions- & Loyalitätstest' : 'Test de Afinidad y Lealtad a Facciones'}
      </h1>

      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        {currentLang === 'en'
          ? 'Answer 4 diagnostic questions to calculate your faction allegiance and save it in your kitchen notebook cookie.'
          : currentLang === 'de'
          ? 'Beantworte 4 Schlüsselfragen, um deine kulinarische Faktion zu berechnen und als Cookie zu speichern.'
          : 'Responde a las preguntas clave para determinar matemáticamente a qué facción perteneces y guardarla en tu cookie culinaria.'}
      </p>
    </header>

    <!-- Interactive Faction Affinity Quiz Component -->
    <div class="space-y-6">
      <FactionAffinityQuiz client:load lang={currentLang} />
    </div>

    <!-- Clarification Note on Trivia Game vs Faction Test -->
    <div class="card-notebook p-6 rounded-2xl bg-[#FCF9F2] border border-[#E8E2D5] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="space-y-1 text-center sm:text-left">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8D6E63]">
          <Gamepad2 class="w-4 h-4 text-[#FFB800]" />
          <span>{currentLang === 'en' ? 'Looking for General Knowledge Trivia?' : currentLang === 'de' ? 'Suchst du das Wissens-Trivia-Spiel?' : '¿Buscabas el Juego de Trivia General?'}</span>
        </div>
        <p class="text-xs text-muted-foreground">
          {currentLang === 'en'
            ? 'Challenge your knowledge with historical facts, food science, and regional records in our full Trivia Game.'
            : currentLang === 'de'
            ? 'Teste dein Wissen über Geschichte, Wissenschaft und Rekorde in unserem vollständigen Trivia-Spiel.'
            : 'Pon a prueba tus conocimientos sobre historia, ciencia y récords con preguntas de 3 opciones en la arena de juego.'}
        </p>
      </div>

      <a
        href={`/${currentLang}/juego-trivia`}
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#FFB800] hover:bg-amber-400 text-[#1C1917] font-bold text-xs shadow-2xs transition-colors shrink-0"
      >
        <span>{currentLang === 'en' ? 'Play Trivia Game 🎮' : currentLang === 'de' ? 'Trivia-Spiel spielen 🎮' : 'Ir al Juego de Trivia 🎮'}</span>
        <span>→</span>
      </a>
    </div>
  </div>
</Layout>
