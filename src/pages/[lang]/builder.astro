---
import Layout from '@/layouts/Layout.astro';
import BuilderApp from '@/components/builder/BuilderApp';
import CulinaryJourneyProgress from '@/components/navigation/CulinaryJourneyProgress.tsx';
import { getTranslations, supportedLanguages } from '@/lib/i18n';
import { createUserRecipeSchema, generateBreadcrumbSchema } from '@/lib/seo';
import { parseConfigurationFromUrl, createTortillaConfiguration } from '@/domain/builder/configCalculator';

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const t = getTranslations(lang);

const title = `${t('builder.title')} - tortilladepatatas.org`;
const description = t('builder.subtitle');

const parsedConfig = parseConfigurationFromUrl(Astro.url.searchParams);
const tortillaConfig = createTortillaConfiguration(parsedConfig);
const currentUrl = `${Astro.url.pathname}${Astro.url.search}`;

const recipeSchema = createUserRecipeSchema(tortillaConfig, lang, currentUrl);

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `/${lang}` },
  { name: t('builder.title'), url: `/${lang}/builder` }
]);

const schemas = [recipeSchema, breadcrumbSchema];
---

<Layout title={title} description={description} lang={lang} schema={schemas}>
  <div class="container mx-auto px-4 max-w-7xl">
    <BuilderApp client:load lang={lang} />
    <CulinaryJourneyProgress lang={lang} currentStepPath={`/${lang}/builder`} client:load />
  </div>
</Layout>
