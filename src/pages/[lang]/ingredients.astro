---
import Layout from '@/layouts/Layout.astro';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Sparkles, Egg, Sprout, Droplet, Circle, Cherry, ShieldCheck, PlusCircle } from 'lucide-react';
import { getTranslations, supportedLanguages } from '@/lib/i18n';
import { generateArticleSchema, generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const t = getTranslations(lang);

const sacredIngredients = [
  {
    key: "potatoes",
    icon: Sprout,
    image: "/images/ingredients/potato_editorial_card.jpg",
    badge: "Monalisa / Kennebec / Agria",
    badgeColor: "bg-amber-100 text-amber-900 border-amber-300",
    iconColor: "text-amber-700 bg-amber-100/80 border-amber-200",
  },
  {
    key: "eggs",
    icon: Egg,
    image: "/images/ingredients/egg_editorial_card.jpg",
    badge: "Frescos Categoría 0 / 1",
    badgeColor: "bg-yellow-100 text-yellow-900 border-yellow-300",
    iconColor: "text-yellow-700 bg-yellow-100/80 border-yellow-200",
  },
  {
    key: "oil",
    icon: Droplet,
    image: "/images/ingredients/olive_oil_editorial_card.jpg",
    badge: "AOVE (Arbequina / Picual)",
    badgeColor: "bg-emerald-100 text-emerald-900 border-emerald-300",
    iconColor: "text-emerald-700 bg-emerald-100/80 border-emerald-200",
  },
  {
    key: "salt",
    icon: Sparkles,
    image: "/images/ingredients/salt_editorial_card.jpg",
    badge: "Sal Marina Fina",
    badgeColor: "bg-blue-100 text-blue-900 border-blue-300",
    iconColor: "text-blue-700 bg-blue-100/80 border-blue-200",
  },
];

const optionalIngredients = [
  {
    key: "onion",
    icon: Circle,
    image: "/images/ingredients/onion_editorial_card.jpg",
    badge: "Opcional - Cebolla Dulce",
    badgeColor: "bg-orange-100 text-orange-900 border-orange-300",
    iconColor: "text-orange-700 bg-orange-100/80 border-orange-200",
  },
  {
    key: "garlic",
    icon: Sparkles,
    image: "/images/ingredients/garlic_editorial_card.jpg",
    badge: "Opcional - Ajo Aromatizante",
    badgeColor: "bg-amber-100 text-amber-900 border-amber-300",
    iconColor: "text-amber-700 bg-amber-100/80 border-amber-200",
  },
  {
    key: "peppers",
    icon: Cherry,
    image: "/images/ingredients/pepper_editorial_card.jpg",
    badge: "Opcional - Pimiento Verde / Rojo",
    badgeColor: "bg-red-100 text-red-900 border-red-300",
    iconColor: "text-red-700 bg-red-100/80 border-red-200",
  },
  {
    key: "blackPepper",
    icon: Sparkles,
    image: "/images/ingredients/black_pepper_editorial_card.jpg",
    badge: "Opcional - Pimienta Negra (Especia)",
    badgeColor: "bg-zinc-200 text-zinc-900 border-zinc-300",
    iconColor: "text-zinc-800 bg-zinc-200/80 border-zinc-300",
  },
];

const title = `${t('ingredientsPage.title')} - tortilladepatatas.org`;
const description = t('ingredientsPage.subtitle');

const articleSchema = generateArticleSchema({
  headline: t("ingredientsPage.title", "Los 4 Ingredientes Sagrados"),
  description: t("ingredientsPage.subtitle", "La patata, el huevo, el aceite de oliva y la sal forman la columna vertebral inviolable de la auténtica tortilla española."),
  url: `/${lang}/ingredients`,
  image: `/images/ingredients/ingredient_flatlay_hero.jpg`,
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `/${lang}` },
  { name: t("ingredientsPage.title", "Ingredientes"), url: `/${lang}/ingredients` }
]);

const schemas = [articleSchema, breadcrumbSchema];
---

<Layout title={title} description={description} lang={lang} schema={schemas}>
  <div class="container mx-auto px-4 py-10 md:py-16 max-w-5xl space-y-12">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <Badge variant="secondary" class="mb-2 px-3.5 py-1 text-xs font-bold bg-[#F5E6BE] text-[#8D6E63] border border-[#E8E2D5] inline-flex items-center gap-1.5 shadow-2xs">
        <Sparkles class="w-3.5 h-3.5" />
        {t("ingredientsPage.badge", "Los Fundamentos")}
      </Badge>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif-heading font-extrabold tracking-tight text-foreground">
        {t("ingredientsPage.title", "Los 4 Ingredientes Sagrados")}
      </h1>
      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed">
        {t("ingredientsPage.subtitle", "La patata, el huevo, el aceite de oliva y la sal forman la columna vertebral inviolable de la auténtica tortilla española.")}
      </p>
    </div>

    <!-- Hero Flatlay Image Banner -->
    <div class="relative rounded-2xl overflow-hidden border border-[#E8E2D5] shadow-sm max-w-5xl mx-auto">
      <div class="aspect-21/9 w-full max-h-[380px] overflow-hidden relative">
        <img
          src="/images/ingredients/ingredient_flatlay_hero.jpg"
          alt="Ingredientes de la Tortilla de Patatas - Flatlay"
          width="1200"
          height="550"
          loading="eager"
          decoding="async"
          referrerPolicy="no-referrer"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent flex items-end p-6 md:p-8">
          <p class="text-white font-serif-heading text-lg md:text-2xl font-bold drop-shadow-md">
            Materia prima excepcional. Técnica depurada.
          </p>
        </div>
      </div>
    </div>

    <!-- SECTION 1: THE 4 SACRED INGREDIENTS -->
    <div class="space-y-6">
      <div class="flex items-center gap-3 border-b border-[#E8E2D5] pb-4">
        <div class="p-2 rounded-xl bg-[#FFB800]/20 text-[#8D6E63] border border-[#FFB800]/40">
          <ShieldCheck class="w-6 h-6 text-[#8D6E63]" />
        </div>
        <div>
          <h2 class="text-2xl font-serif-heading font-extrabold text-foreground">
            {t("ingredientsPage.sacredSectionTitle", "Los 4 Sagrados e Imprescindibles")}
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            {t("ingredientsPage.sacredSectionSubtitle", "Sin estos cuatro elementos no existe la tortilla. La proporción justa y la máxima calidad son la clave.")}
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        {sacredIngredients.map((item, index) => {
          const Icon = item.icon;
          return (
            <Card key={item.key} class="card-notebook overflow-hidden flex flex-col justify-between">
              <div>
                <div class="h-48 w-full overflow-hidden relative border-b border-[#E8E2D5]">
                  <img
                    src={item.image}
                    alt={t(`ingredientsPage.${item.key}.title`, item.key)}
                    width="600"
                    height="400"
                    loading={index < 2 ? "eager" : "lazy"}
                    decoding="async"
                    referrerPolicy="no-referrer"
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
                  <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between">
                    <span class={`text-[11px] font-bold px-2.5 py-1 rounded-full border shadow-2xs ${item.badgeColor}`}>
                      {item.badge}
                    </span>
                  </div>
                </div>

                <CardHeader class="pb-3 pt-4">
                  <div class="flex items-center gap-3">
                    <div class={`p-2.5 rounded-xl border shadow-2xs ${item.iconColor}`}>
                      <Icon class="w-5 h-5" />
                    </div>
                    <div>
                      <CardTitle class="text-xl font-serif-heading font-bold text-foreground">
                        {t(`ingredientsPage.${item.key}.title`, item.key)}
                      </CardTitle>
                      <span class="text-xs font-semibold text-[#8D6E63] block mt-0.5">
                        {t(`ingredientsPage.${item.key}.subtitle`, '')}
                      </span>
                    </div>
                  </div>
                </CardHeader>

                <CardContent>
                  <p class="text-muted-foreground leading-relaxed text-xs sm:text-sm">
                    {t(`ingredientsPage.${item.key}.desc`, '')}
                  </p>
                </CardContent>
              </div>
            </Card>
          );
        })}
      </div>
    </div>

    <!-- SECTION 2: OPTIONAL INGREDIENTS & VARIATIONS -->
    <div class="space-y-6 pt-4">
      <div class="flex items-center gap-3 border-b border-[#E8E2D5] pb-4">
        <div class="p-2 rounded-xl bg-orange-100 text-orange-800 border border-orange-200">
          <PlusCircle class="w-6 h-6" />
        </div>
        <div>
          <h2 class="text-2xl font-serif-heading font-extrabold text-foreground">
            {t("ingredientsPage.optionalSectionTitle", "Ingredientes Opcionales y Variaciones")}
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            {t("ingredientsPage.optionalSectionSubtitle", "Acompañantes tradicionales y toques personales que enriquecen o transforman la receta.")}
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {optionalIngredients.map((item) => {
          const Icon = item.icon;
          return (
            <Card key={item.key} class="card-notebook overflow-hidden flex flex-col justify-between">
              <div>
                <div class="h-44 w-full overflow-hidden relative border-b border-[#E8E2D5]">
                  <img
                    src={item.image}
                    alt={t(`ingredientsPage.${item.key}.title`, item.key)}
                    width="600"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    referrerPolicy="no-referrer"
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent" />
                  <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
                    <span class={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border shadow-2xs ${item.badgeColor}`}>
                      {item.badge}
                    </span>
                  </div>
                </div>

                <CardHeader class="pb-2 pt-4">
                  <div class="flex items-center gap-2.5">
                    <div class={`p-2 rounded-xl border shadow-2xs ${item.iconColor}`}>
                      <Icon class="w-4 h-4" />
                    </div>
                    <div>
                      <CardTitle class="text-lg font-serif-heading font-bold text-foreground">
                        {t(`ingredientsPage.${item.key}.title`, item.key)}
                      </CardTitle>
                      <span class="text-[11px] font-semibold text-[#8D6E63] block mt-0.5">
                        {t(`ingredientsPage.${item.key}.subtitle`, '')}
                      </span>
                    </div>
                  </div>
                </CardHeader>

                <CardContent>
                  <p class="text-muted-foreground leading-relaxed text-xs">
                    {t(`ingredientsPage.${item.key}.desc`, '')}
                  </p>
                </CardContent>
              </div>
            </Card>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
