---
import Layout from '@/layouts/Layout.astro';
import PotatoIngredientDetail from '@/components/ingredients/PotatoIngredientDetail';
import { supportedLanguages } from '@/lib/i18n';
import { getRecipesForTaxonomy } from '@/lib/taxonomy';
import { SITE_URL, generateBreadcrumbSchema, generateArticleSchema } from '@/lib/seo';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';

const recipes = await getRecipesForTaxonomy('ingredient', 'potato');

const customHreflangs = [
  { lang: 'es', href: `${SITE_URL}/es/ingredientes/patata` },
  { lang: 'en', href: `${SITE_URL}/en/ingredients/potato` },
  { lang: 'de', href: `${SITE_URL}/de/zutaten/kartoffel` },
  { lang: 'x-default', href: `${SITE_URL}/es/ingredientes/patata` },
];

const title = currentLang === 'en'
  ? 'The Potato (Solanum tuberosum) | Ingredient Monograph | tortilladepatatas.org'
  : currentLang === 'de'
  ? 'Die Kartoffel (Solanum tuberosum) | Zutaten-Monographie | tortilladepatatas.org'
  : 'La Patata (Solanum tuberosum) | Monografía de Ingrediente | tortilladepatatas.org';

const description = currentLang === 'en'
  ? 'Comprehensive guide to potatoes in Spanish tortilla: varieties, starch science, cutting geometry, and thermal poaching techniques.'
  : currentLang === 'de'
  ? 'Umfassender Leitfaden zur Kartoffel in der spanischen Tortilla: Sorten, Stärkewissenschaft, Schnittgeometrie und Confitiertechniken.'
  : 'Guía enciclopédica sobre la patata en la tortilla española: variedades, ciencia del almidón, geometría de corte y técnicas de confitado.';

const breadcrumbsList = [
  { name: currentLang === 'de' ? 'Startseite' : currentLang === 'en' ? 'Home' : 'Inicio', url: `/${currentLang}` },
  { name: currentLang === 'de' ? 'Zutaten' : currentLang === 'en' ? 'Ingredients' : 'Ingredientes', url: `/${currentLang}/ingredientes` },
  { name: currentLang === 'de' ? 'Kartoffel' : currentLang === 'en' ? 'Potato' : 'Patata', url: `/${currentLang}/ingredientes/patata` },
];

const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbsList);
const articleSchema = generateArticleSchema({
  headline: 'La Patata (Solanum tuberosum)',
  description: description,
  url: `${SITE_URL}/${currentLang}/ingredientes/patata`,
  image: '/images/ingredients/potato_editorial_card.jpg',
});

const schemas = [breadcrumbSchema, articleSchema];
---

<Layout
  title={title}
  description={description}
  lang={currentLang}
  schema={schemas}
  breadcrumbs={breadcrumbsList}
  canonical={`${SITE_URL}/${currentLang}/ingredientes/patata`}
  customHreflangs={customHreflangs}
>
  <PotatoIngredientDetail
    lang={currentLang}
    relatedRecipes={recipes}
    client:load
  />
</Layout>
