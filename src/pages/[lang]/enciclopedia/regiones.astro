---
import { supportedLanguages } from '@/lib/i18n';
import { getTaxonomyRoutePrefix } from '@/lib/taxonomy';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const prefix = getTaxonomyRoutePrefix('region', lang);
return Astro.redirect(`/${lang}/${prefix}`);
---
