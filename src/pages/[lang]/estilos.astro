---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { supportedLanguages, getTranslations } from '@/lib/i18n';
import { generateBreadcrumbSchema, generateArticleSchema } from '@/lib/seo';
import { Palette, Sparkles, ArrowRight, ShieldCheck } from 'lucide-react';
import { getTaxonomyUrl } from '@/lib/taxonomy';

export async function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';
const t = getTranslations(currentLang);

const allTaxonomies = await getCollection('taxonomies');
const styleTaxonomies = allTaxonomies.filter((item) => item.data.type === 'style');

const pageTitle = `${t('nav.estilos', 'Estilos de Tortilla')} | tortilladepatatas.org`;
const pageDescription = 'Explora los principales estilos tradicionales y contemporáneos de tortilla de patatas.';

const articleSchema = generateArticleSchema({
  headline: t('nav.estilos', 'Estilos de Tortilla'),
  description: pageDescription,
  url: `/${currentLang}/estilos`,
});

const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Inicio', url: `/${currentLang}` },
  { name: 'Universo Tortilla', url: `/${currentLang}/enciclopedia` },
  { name: 'Estilos', url: `/${currentLang}/estilos` },
]);
---

<Layout title={pageTitle} description={pageDescription} lang={currentLang} schema={[articleSchema, breadcrumbSchema]}>
  <div class="container mx-auto px-4 py-10 md:py-16 max-w-5xl space-y-10">
    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#F5E6BE] text-[#8D6E63] border border-amber-300 text-xs font-bold shadow-2xs">
        <Palette class="w-3.5 h-3.5" />
        <span>Categoría Gastronómica</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-serif-heading font-extrabold tracking-tight text-[#292521]">
        Estilos de Tortilla de Patatas
      </h1>
      <p class="text-base sm:text-lg text-foreground/80 leading-relaxed">
        Desde el icónico huevo líquido de Betanzos hasta el cuajado firme tradicional y las variantes paisanas.
      </p>
    </header>

    <!-- Styles Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {styleTaxonomies.map((item) => {
        const data = item.data;
        const titleText = data.title[currentLang as keyof typeof data.title] || data.title.es;
        const descText = data.description[currentLang as keyof typeof data.description] || data.description.es;
        const badgeText = data.badge ? (data.badge[currentLang as keyof typeof data.badge] || data.badge.es) : 'Tradicional';
        const url = getTaxonomyUrl('style', data.id, currentLang);

        return (
          <a
            href={url}
            class="card-notebook p-6 rounded-2xl border border-[#E8E2D5] bg-[#FCF9F2] hover:border-[#FFB800] hover:shadow-md transition-all flex flex-col justify-between group"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold px-2.5 py-1 rounded-full bg-[#F5E6BE] text-[#8D6E63] border border-amber-200">
                  {badgeText}
                </span>
                <Sparkles class="w-4 h-4 text-[#FFB800]" />
              </div>
              <h2 class="text-xl font-serif-heading font-bold text-[#292521] group-hover:text-[#8D6E63] transition-colors">
                {titleText}
              </h2>
              <p class="text-xs sm:text-sm text-foreground/80 leading-relaxed">
                {descText}
              </p>
            </div>

            <div class="pt-6 flex items-center gap-1.5 text-xs font-bold text-[#8D6E63] group-hover:text-[#292521] transition-colors">
              <span>Ver Ficha y Recetas</span>
              <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>

    <!-- Safety Note -->
    <section class="card-notebook p-5 sm:p-6 rounded-2xl bg-[#FCF9F2] border-l-4 border-l-[#2E7D32] border border-[#E8E2D5] shadow-xs">
      <div class="flex items-start gap-3 text-xs sm:text-sm text-foreground/90">
        <ShieldCheck class="w-5 h-5 text-[#2E7D32] shrink-0 mt-0.5" />
        <p class="font-sans">
          Estándar Bactericida: Para garantizar la inocuidad en cualquier estilo, se exige alcanzar <strong class="font-bold text-[#8D6E63] bg-[#F5E6BE] px-1 py-0.5 rounded">70°C durante 2 minutos</strong> o <strong class="font-bold text-[#8D6E63] bg-[#F5E6BE] px-1 py-0.5 rounded">63°C durante 20 segundos</strong>. No superar las <strong class="font-bold text-[#8D6E63] bg-[#F5E6BE] px-1 py-0.5 rounded">4 horas</strong> a temperatura ambiente.
        </p>
      </div>
    </section>
  </div>
</Layout>
