---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/home/Hero';
import FeatureGrid from '@/components/home/FeatureGrid';
import BuilderTeaser from '@/components/home/BuilderTeaser';
import AuthorityStatsBanner from '@/components/home/AuthorityStatsBanner';
import KitchenToolsTeaser from '@/components/home/KitchenToolsTeaser';
import NewsletterLeadMagnet from '@/components/home/NewsletterLeadMagnet';
import { getTranslations, supportedLanguages } from '@/lib/i18n';
import {
  generateWebSiteSchema,
  generateOrganizationSchema,
  generateBreadcrumbSchema,
} from '@/lib/seo';
import { getAllRecipes } from '@/lib/taxonomy';

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const currentLang = (lang === 'es' || lang === 'en' || lang === 'de') ? lang : 'es';
const t = getTranslations(currentLang);

const recipes = await getAllRecipes();
const recipeCount = recipes.length;

const title = currentLang === 'es'
  ? 'Tortilla de Patatas: La Enciclopedia, Ciencia, Recetas & Menaje Culinario'
  : currentLang === 'de'
  ? 'Tortilla de Patatas: Die Enzyklopädie, Wissenschaft & Küchenwerkzeuge'
  : 'Spanish Omelette (Tortilla de Patatas): Science, Master Recipes & Culinary Tools';

const description = currentLang === 'es'
  ? 'La mayor autoridad mundial en tortilla de patatas: recetas tradicionales, ciencia del cuajado a 70°C, termodinámica de la patata, guía de peladores, sartenes dobles y calculadoras maestras.'
  : currentLang === 'de'
  ? 'Die weltweite Referenz für spanische Tortilla: Traditionsrezepte, 70°C Thermosicherheit, Sparschäler-Vergleich, Doppelpfannen und exakte Mengenkalkulation.'
  : 'The world reference encyclopedia on Spanish tortilla: authentic recipes, 70°C thermal food safety science, potato peeler guides, double flip pans, and ratio calculators.';

const schemas = [
  generateWebSiteSchema(),
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Inicio', url: `/${currentLang}` }
  ]),
];
---

<Layout title={title} description={description} lang={currentLang} schema={schemas}>
  <Hero lang={currentLang} client:load />
  <AuthorityStatsBanner lang={currentLang} recipeCount={recipeCount} client:load />
  <FeatureGrid lang={currentLang} client:load />
  <KitchenToolsTeaser lang={currentLang} client:load />
  <BuilderTeaser lang={currentLang} client:load />
  <NewsletterLeadMagnet lang={currentLang} client:load />
</Layout>
