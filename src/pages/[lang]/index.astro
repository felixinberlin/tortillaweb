---
import Layout from '@/layouts/Layout.astro';
import Hero from '@/components/home/Hero';
import FeatureGrid from '@/components/home/FeatureGrid';
import BuilderTeaser from '@/components/home/BuilderTeaser';
import { getTranslations, supportedLanguages } from '@/lib/i18n';
import { generateWebSiteSchema, generateOrganizationSchema, generateBreadcrumbSchema } from '@/lib/seo';

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({
    params: { lang },
  }));
}

const { lang = 'es' } = Astro.params;
const t = getTranslations(lang);

const title = `${t('hero.title')} - tortilladepatatas.org`;
const description = t('hero.subtitle');

const schemas = [
  generateWebSiteSchema(),
  generateOrganizationSchema(),
  generateBreadcrumbSchema([
    { name: 'Inicio', url: `/${lang}` }
  ])
];
---

<Layout title={title} description={description} lang={lang} schema={schemas}>
  <Hero lang={lang} client:load />
  <FeatureGrid lang={lang} client:load />
  <BuilderTeaser lang={lang} client:load />
</Layout>
