<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
  <file source-language="es" target-language="de" datatype="plaintext" original="trivia_canon">
    <header>
      <tool tool-id="tortilladepatatas-i18n" tool-name="Tortilla Editorial Intelligence Trivia Canon" />
      <note priority="1">Canonical UI strings and gameplay constants for the Tortilla Trivia Game engine.</note>
    </header>
    <body>
      <trans-unit id="trivia.title" resname="TRIVIA_TITLE">
        <source>Juego de Trivia: Desafío de la Tortilla</source>
        <target>Das große Tortilla Trivia-Spiel</target>
      </trans-unit>
      <trans-unit id="trivia.subtitle" resname="TRIVIA_SUBTITLE">
        <source>Pon a prueba tus conocimientos sobre historia, mitos regionales, récords monumentales y seguridad alimentaria.</source>
        <target>Teste dein Wissen über Geschichte, Mythen, Rekorde und bakteriologische Sicherheit.</target>
      </trans-unit>
      <trans-unit id="trivia.select_level" resname="TRIVIA_SELECT_LEVEL">
        <source>Selecciona el Nivel de Dificultad</source>
        <target>Schwierigkeitsgrad wählen</target>
      </trans-unit>
      <trans-unit id="trivia.select_topic" resname="TRIVIA_SELECT_TOPIC">
        <source>Selecciona el Tema</source>
        <target>Thema wählen</target>
      </trans-unit>
      <trans-unit id="trivia.start_button" resname="TRIVIA_START_BUTTON">
        <source>Comenzar Juego de Trivia</source>
        <target>Spiel starten</target>
      </trans-unit>
      <trans-unit id="trivia.question_of" resname="TRIVIA_QUESTION_OF">
        <source>Pregunta</source>
        <target>Frage</target>
      </trans-unit>
      <trans-unit id="trivia.of" resname="TRIVIA_OF">
        <source>de</source>
        <target>von</target>
      </trans-unit>
      <trans-unit id="trivia.score" resname="TRIVIA_SCORE">
        <source>Puntos</source>
        <target>Punkte</target>
      </trans-unit>
      <trans-unit id="trivia.streak" resname="TRIVIA_STREAK">
        <source>Racha</source>
        <target>Serie</target>
      </trans-unit>
      <trans-unit id="trivia.next_question" resname="TRIVIA_NEXT_QUESTION">
        <source>Siguiente Pregunta</source>
        <target>Nächste Frage</target>
      </trans-unit>
      <trans-unit id="trivia.view_results" resname="TRIVIA_VIEW_RESULTS">
        <source>Ver Resultados Finales</source>
        <target>Ergebnis anzeigen</target>
      </trans-unit>
      <trans-unit id="trivia.correct" resname="TRIVIA_CORRECT">
        <source>¡Correcto!</source>
        <target>Richtig!</target>
      </trans-unit>
      <trans-unit id="trivia.incorrect" resname="TRIVIA_INCORRECT">
        <source>Incorrecto</source>
        <target>Falsch</target>
      </trans-unit>
      <trans-unit id="trivia.verdict_label" resname="TRIVIA_VERDICT_LABEL">
        <source>Explicación Histórica &amp; Científica</source>
        <target>Historische &amp; Wissenschaftliche Erklärung</target>
      </trans-unit>
      <trans-unit id="trivia.safety_highlight" resname="TRIVIA_SAFETY_HIGHLIGHT">
        <source>Estándar Térmico de Seguridad</source>
        <target>Mikrobiologischer Standard</target>
      </trans-unit>
      <trans-unit id="trivia.game_completed" resname="TRIVIA_GAME_COMPLETED">
        <source>¡Desafío Completado!</source>
        <target>Challenge Beendet!</target>
      </trans-unit>
      <trans-unit id="trivia.accuracy" resname="TRIVIA_ACCURACY">
        <source>Precisión</source>
        <target>Genauigkeit</target>
      </trans-unit>
      <trans-unit id="trivia.max_streak" resname="TRIVIA_MAX_STREAK">
        <source>Racha Máxima</source>
        <target>Max. Serie</target>
      </trans-unit>
      <trans-unit id="trivia.share_score" resname="TRIVIA_SHARE_SCORE">
        <source>Compartir Puntuación y Desafiar Amigos</source>
        <target>Ergebnis teilen &amp; Freunde herausfordern</target>
      </trans-unit>
      <trans-unit id="trivia.copy_score_card" resname="TRIVIA_COPY_SCORE_CARD">
        <source>Copiar Tarjeta de Resultado</source>
        <target>Ergebniskarte kopieren</target>
      </trans-unit>
      <trans-unit id="trivia.play_again" resname="TRIVIA_PLAY_AGAIN">
        <source>Jugar de Nuevo</source>
        <target>Nochmal spielen</target>
      </trans-unit>
      <trans-unit id="trivia.change_settings" resname="TRIVIA_CHANGE_SETTINGS">
        <source>Cambiar Nivel o Tema</source>
        <target>Level oder Thema ändern</target>
      </trans-unit>
      <trans-unit id="trivia.review_questions" resname="TRIVIA_REVIEW_QUESTIONS">
        <source>Desglose de Preguntas &amp; Explicaciones</source>
        <target>Fragen-Übersicht &amp; Erklärungen</target>
      </trans-unit>
      <trans-unit id="trivia.copied_text" resname="TRIVIA_COPIED_TEXT">
        <source>¡Tarjeta de resultado copiada al portapapeles!</source>
        <target>Ergebniskarte in Zwischenablage kopiert!</target>
      </trans-unit>
    </body>
  </file>
</xliff>
