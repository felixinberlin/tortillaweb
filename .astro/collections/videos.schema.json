{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "object",
      "properties": {
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "es",
        "en",
        "de"
      ]
    },
    "description": {
      "type": "object",
      "properties": {
        "es": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "es",
        "en",
        "de"
      ]
    },
    "videoId": {
      "type": "string"
    },
    "thumbnailUrl": {
      "type": "string"
    },
    "duration": {
      "type": "number"
    },
    "lang": {
      "default": "es",
      "type": "string",
      "enum": [
        "es",
        "en",
        "de"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "technique",
        "interview",
        "history",
        "science"
      ]
    },
    "relatedRecipeIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "description",
    "category"
  ]
}