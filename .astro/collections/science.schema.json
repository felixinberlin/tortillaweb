{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "contentId": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "locale": {
      "type": "string",
      "enum": [
        "es",
        "en",
        "de"
      ]
    },
    "translationKey": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ]
}